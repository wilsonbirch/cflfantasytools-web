{
    "name": "cflfantasytools-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.22.0"
    },
    "scripts": {
        "dev": "react-router dev",
        "build": "react-router build",
        "start": "react-router-serve ./build/server/index.js",
        "typecheck": "react-router typegen && tsc",
        "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint app tests",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "codegen": "graphql-codegen",
        "schema:pull": "node scripts/pull-schema.mjs"
    },
    "dependencies": {
        "@heroui/react": "^3.2.7",
        "@react-router/node": "^8.5.1",
        "@react-router/serve": "^8.5.1",
        "baseline-browser-mapping": "^2.11.35",
        "caniuse-lite": "^1.0.30001823",
        "graphql": "^16.11.0",
        "graphql-request": "^7.2.0",
        "isbot": "^5.2.2",
        "next-themes": "^0.4.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "remixicon": "^4.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@graphql-codegen/cli": "^8.0.0",
        "@graphql-codegen/client-preset": "^7.0.0",
        "@playwright/test": "^1.65.0",
        "@react-router/dev": "^8.5.1",
        "@react-router/fs-routes": "^8.5.1",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/ui": "^5.1.0",
        "dotenv": "^18.0.9",
        "dotenv-cli": "^11.1.0",
        "eslint": "^9.39.4",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^29.1.1",
        "postcss": "^8.5.6",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.0.11",
        "vitest": "^5.1.0",
        "vitest-mock-extended": "^5.1.1"
    }
}
